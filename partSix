def main():

    score = input("What is your grade score?")
    print(myFunction(score))

def myFunction(grade):
    if float(grade) >= 90:
        return "A"
    elif float(grade) >= 80:
        return "B"
    elif float(grade) >= 70:
        return "C"
    elif float(grade) >= 60:
        return "D"
    else:
        return "F"

main()